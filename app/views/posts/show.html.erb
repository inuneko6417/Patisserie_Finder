<div class="bg-gray-100 py-10">
  <div class="max-w-4xl mx-auto bg-white shadow-lg rounded-lg overflow-hidden">
    <div data-controller="posts_image">
      <!-- ヘッダー -->
      <div class="bg-gray-800 text-white text-center py-4">
        <h1 class="text-lg font-semibold"><%= @post.title %></h1>
      </div>

      <div class="flex h-30 items-center space-x-4 bg-gray-50 p-3 rounded-lg shadow-sm">
        <!-- プロフィール画像 -->
        <div class="w-14 h-14">
          <%= image_tag @post.user.profile.url, class: "w-full h-full rounded-full object-cover border border-gray-300 shadow-sm" %>
        </div>

        <!-- ユーザー情報 -->
        <div class="flex-1">
          <h3 class="text-2xl font-bold text-gray-900 shadow-lg">
            <%= @post.user.name %>
          </h3>
          <p class="text-sm text-gray-500 mt-1 italic">投稿者</p>
        </div>
      </div>

      <!-- Swiperのメイン画像スライダー -->
      <div class="bg-white px-6 py-16">
        <div class="swiper mySwiper">
          <div class="swiper-wrapper">
            <% @post.images.each do |image| %>
              <div class="swiper-slide">
                <%= image_tag(image, alt: "投稿画像", class: "object-scale-down w-full h-96 rounded-lg") %>
              </div>
            <% end %>
          </div>

          <!-- ナビゲーションボタン -->
          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
          <!-- ページネーション -->
          <div class="swiper-pagination"></div>
        </div>

        <!-- サムネイル（サブ画像スライダー） -->
        <div class="swiper myThumbs mt-4">
          <div class="swiper-wrapper">
            <% @post.images.each do |image| %>
              <div class="swiper-slide cursor-pointer">
                <%= image_tag(image, alt: "投稿画像", class: "object-cover w-20 h-20 rounded-md") %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Googleマップを横並びに -->
      <div class="px-6 py-8 border-t border-gray-200">
        <div class="flex flex-col lg:flex-row gap-8">
          <!-- 本文セクション -->
          <div class="flex-1">
            <label class="block text-gray-700 font-semibold mb-4 text-lg">レビュー</label>
            <div class="p-6 rounded-lg">
              <p class="text-gray-800 leading-relaxed">
                <%= @post.body %>
              </p>
            </div>
          </div>

          <!-- Googleマップセクション -->
          <div class="flex-1">
            <label class="block text-gray-700 font-semibold mb-4 text-lg">場所</label>
            <div class="p-2 rounded-lg">
              <iframe
                width="100%"
                height="300"
                style="border:0"
                loading="lazy"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"
                src="https://www.google.com/maps?q=<%= ERB::Util.url_encode(@post.title) %>&output=embed"
                class="rounded-md">
              </iframe>
            </div>
          </div>
        </div>
      </div>

      <!-- コメントセクション -->
      <div class="px-6 py-8 border-t border-gray-200">
        <!-- コメントフォーム -->
        <div class="mb-8">
          <%= render 'comments/form', comment: @comment, post: @post %>
        </div>

        <!-- コメント -->
        <h2 class="text-lg font-semibold mb-4">コメント</h2>
        <div id="table-comment">
          <%= render @comments %>
        </div>
      </div>
    </div>
  </div>
</div>
